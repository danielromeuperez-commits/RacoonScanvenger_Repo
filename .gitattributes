# =====================================================================
# .gitattributes — Unity 6 (URP) · válido para proyectos 2D y 3D
# ---------------------------------------------------------------------
# Estrategia:
#   1. Archivos serializados de Unity (YAML) -> TEXTO + Smart Merge
#      (UnityYAMLMerge). NUNCA en LFS: LFS impide fusionarlos y
#      multiplicaría los conflictos en escenas y prefabs.
#   2. Assets binarios pesados (texturas, modelos, audio, vídeo...)
#      -> Git LFS.
#
# Requiere en Unity:
#   Project Settings > Editor > Asset Serialization: Force Text
#   Project Settings > Version Control > Mode: Visible Meta Files
#
# Nota: los patrones tipo *.[Ff][Bb][Xx] cubren cualquier combinación
# de mayúsculas/minúsculas (SK_Rohja.fbx, Modelo.FBX, etc.).
# =====================================================================

# --- Normalización por defecto (Git decide texto/binario) ---
* text=auto

# =====================================================================
# 1) ARCHIVOS SERIALIZADOS DE UNITY (YAML) — texto + UnityYAMLMerge
#    Fusión automática inteligente en escenas, prefabs y assets.
# =====================================================================
*.meta                 text eol=lf
*.unity                text eol=lf merge=unityyamlmerge
*.prefab               text eol=lf merge=unityyamlmerge
*.asset                text eol=lf merge=unityyamlmerge
*.mat                  text eol=lf merge=unityyamlmerge
*.anim                 text eol=lf merge=unityyamlmerge
*.controller           text eol=lf merge=unityyamlmerge
*.overrideController   text eol=lf merge=unityyamlmerge
*.mask                 text eol=lf merge=unityyamlmerge
*.playable             text eol=lf merge=unityyamlmerge
*.signal               text eol=lf merge=unityyamlmerge
*.physicMaterial       text eol=lf merge=unityyamlmerge
*.physicsMaterial2D    text eol=lf merge=unityyamlmerge
*.spriteatlas          text eol=lf merge=unityyamlmerge
*.spriteatlasv2        text eol=lf merge=unityyamlmerge
*.terrainlayer         text eol=lf merge=unityyamlmerge
*.mixer                text eol=lf merge=unityyamlmerge
*.shadervariants       text eol=lf merge=unityyamlmerge
*.preset               text eol=lf merge=unityyamlmerge
*.brush                text eol=lf merge=unityyamlmerge
*.flare                text eol=lf merge=unityyamlmerge
*.fontsettings         text eol=lf merge=unityyamlmerge
*.guiskin              text eol=lf merge=unityyamlmerge
*.giparams             text eol=lf merge=unityyamlmerge
*.renderTexture        text eol=lf merge=unityyamlmerge
*.cubemap              text eol=lf merge=unityyamlmerge

# --- Excepciones: .asset que Unity SIEMPRE serializa en binario ---
#     (van a LFS aunque la regla *.asset diga texto; la última regla gana)
LightingData.asset          filter=lfs diff=lfs merge=lfs -text
OcclusionCullingData.asset  filter=lfs diff=lfs merge=lfs -text
NavMesh.asset               filter=lfs diff=lfs merge=lfs -text

# =====================================================================
# 2) CÓDIGO, SHADERS Y FORMATOS DE TEXTO (JSON/XML/UI Toolkit)
# =====================================================================
*.cs          text diff=csharp
*.shader      text
*.cginc       text
*.hlsl        text
*.compute     text
*.raytrace    text
*.shadergraph     text
*.shadersubgraph  text
*.inputactions    text
*.asmdef      text
*.asmref      text
*.rsp         text
*.uxml        text
*.uss         text
*.tss         text
*.json        text
*.xml         text
*.yaml        text
*.yml         text
*.txt         text
*.md          text
*.csv         text

